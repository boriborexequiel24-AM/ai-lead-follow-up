    {
      "id": "60f8a3cc-fa2f-5729-90e5-fc0fa58dca44",
      "name": "Send to agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.agent_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $('Config').first().json.webhook_secret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "224b73ab-d733-5264-a196-e89b9e22d17c",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        300
      ],
      "parameters": {
        "jsCode": "// What happened to this message. 200 means the agent has it.\nconst src = $('Parse email').item.json;\nreturn { json: { id: src.id, labelled: src.labelled, from: src.payload.email, status: $json.statusCode,\n                 ok: $json.statusCode === 200, final_action: $json.body?.final_action ?? null } };",
        "mode": "runOnceForEachItem"
      }
    },
