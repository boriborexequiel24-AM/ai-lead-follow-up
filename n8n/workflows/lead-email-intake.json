{
  "name": "Lead Follow-Up | 2. Email intake",
  "nodes": [
    {
      "id": "ad3ed762-f030-5f8c-a7cf-e0f6ae477c00",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "7a546d04-33ea-5d96-8ba7-5d2629958837",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Generated by scripts/build_n8n_workflows.py.\nreturn [{ json: {\n  \"supabase_url\": \"https://YOUR-PROJECT.supabase.co\",\n  \"agent_url\": \"https://YOUR-N8N-DOMAIN/webhook/lead-message\",\n  \"webhook_secret\": \"YOUR-N8N-WEBHOOK-SECRET\",\n  \"alerts_channel\": \"YOUR-ALERTS-CHANNEL-ID\",\n  \"intake_address\": \"intake@example.com\",\n  \"label_name\": \"lead-demo\"\n} }];"
      }
    },
    {
      "id": "7af33ec1-68fa-5855-9ddf-87c7d0b20f4c",
      "name": "Get mailbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "d062a259-4c73-5bdc-9e3e-b9209286906e",
      "name": "Check mailbox",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Safety check: only ever read the mailbox this demo is meant to use.\nconst config = $('Config').first().json;\nconst address = String($input.first().json.emailAddress || '').toLowerCase();\nif (address !== config.intake_address) {\n  throw new Error(`The Gmail credential is signed in to ${address || 'an unknown account'}, not ${config.intake_address}.`);\n}\nreturn [{ json: { ok: true } }];"
      }
    },
    {
      "id": "2b5198a8-d9e9-58c0-81d0-da381a9141b9",
      "name": "Get labels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/labels",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "71835ce5-fa33-585b-bda8-1509d9c8a089",
      "name": "Find label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Gmail needs a label id, not a name, to search by it and take it off.\nconst wanted = $('Config').first().json.label_name.toLowerCase();\nconst match = ($input.first().json.labels || []).find(l => String(l.name).toLowerCase() === wanted);\nif (!match) throw new Error(`No Gmail label named \"${$('Config').first().json.label_name}\". Create it first.`);\nreturn [{ json: { label_id: match.id } }];"
      }
    },
    {
      "id": "8023224e-ba43-5657-ad02-33c7d5a1e8f5",
      "name": "List labelled",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=10&labelIds={{ $('Find label').first().json.label_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "85584970-6aca-51b2-8c0d-c9c65db6494c",
      "name": "Get lead threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/leads?select=email_thread_id&email_thread_id=not.is.null&updated_at=gte.{{ new Date(Date.now() - 30 * 864e5).toISOString() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept-Profile",
              "value": "leads"
            },
            {
              "name": "Content-Profile",
              "value": "leads"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "0c6d0a9a-a7b2-5f71-a12e-4ff66e8dde99",
      "name": "List recent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=50&q={{ encodeURIComponent(\"in:inbox newer_than:2d -label:lead-demo\") }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        }
      },
      "executeOnce": true
    },
    {
      "id": "838f1f06-d865-59ec-9998-e108a5aeb2c6",
      "name": "Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "jsCode": "// New leads (labelled) plus replies (recent mail in a known lead thread).\nconst labelled = $('List labelled').first().json.messages || [];\nconst recent = $('List recent').first().json.messages || [];\nconst threads = new Set(($('Get lead threads').all() || []).map(i => i.json.email_thread_id).filter(Boolean));\n\nconst seen = new Set();\nconst out = [];\nfor (const m of labelled) {\n  if (!seen.has(m.id)) { seen.add(m.id); out.push({ json: { id: m.id, labelled: true } }); }\n}\nfor (const m of recent) {\n  if (threads.has(m.threadId) && !seen.has(m.id)) { seen.add(m.id); out.push({ json: { id: m.id, labelled: false } }); }\n}\nreturn out;  // nothing to do means no items, and the run stops here"
      }
    },
    {
      "id": "95139eab-5851-55e4-a4f2-c82e0ec09b94",
      "name": "Already in?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/messages?select=external_id&external_id=in.({{ $('Candidates').all().map(i => i.json.id).join(',') }})",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept-Profile",
              "value": "leads"
            },
            {
              "name": "Content-Profile",
              "value": "leads"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "dea3f986-50c3-58d4-8cb3-cb8edcae6105",
      "name": "New only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "jsCode": "// Skip messages the agent already has. A labelled one that's already in only\n// needs its label taken off (an earlier run must have failed after handing it over).\nconst done = new Set(($input.all() || []).map(i => i.json.external_id).filter(Boolean));\nreturn $('Candidates').all().map(i => ({ json: { ...i.json, already_in: done.has(i.json.id) } }));"
      }
    },
    {
      "id": "4b93f720-b429-50c5-9ad7-9893fa3b0f89",
      "name": "Already in agent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "efa430e6-e69d-57cb-bd24-ddcd97e6a09c",
              "leftValue": "={{ $json.already_in }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e9556eef-1cfe-52e4-b980-e498b16f0ffb",
      "name": "Get message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages/{{ $json.id }}?format=full",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "83cdc61b-a87c-5ebd-81a5-2fc1b18d07f1",
      "name": "Parse email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        300
      ],
      "parameters": {
        "jsCode": "// Turn a Gmail message into a lead message: sender, subject, plain-text body\n// with the quoted history cut off.\nconst config = $('Config').first().json;\nconst msg = $json;\nconst headers = {};\nfor (const h of msg.payload?.headers || []) headers[String(h.name).toLowerCase()] = h.value;\n\nconst fromRaw = headers.from || '';\nconst m = fromRaw.match(/^\\s*\"?([^\"<]*?)\"?\\s*<([^>]+)>\\s*$/);\nconst email = (m ? m[2] : fromRaw).trim().toLowerCase();\nconst name = (m ? m[1] : '').trim() || null;\n\nconst decode = data => Buffer.from(String(data).replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8');\nconst find = (part, type) => {\n  if (!part) return null;\n  if (part.mimeType === type && part.body?.data) return decode(part.body.data);\n  for (const p of part.parts || []) { const found = find(p, type); if (found) return found; }\n  return null;\n};\nlet text = find(msg.payload, 'text/plain');\nif (!text) {\n  const html = find(msg.payload, 'text/html') || '';\n  text = html.replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/p>/gi, '\\n').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');\n}\n// Cut the quoted earlier messages so the agent only reads what's new.\ntext = text.split(/\\r?\\n[^\\n]*On [^\\n]{0,200}wrote:/)[0]\n           .split(/\\r?\\n-{2,} ?Original Message/i)[0]\n           .split(/\\r?\\n>/)[0]\n           .trim()\n           .slice(0, 4000);\n\nconst own = email === config.intake_address;\nconst automated = /mailer-daemon|no-?reply|postmaster/i.test(email);\n\nreturn {\n  json: {\n    id: msg.id,\n    labelled: $('New only').item.json.labelled,\n    skip: own || automated || !text,\n    skip_reason: own ? 'sent by the intake address' : automated ? 'automated sender' : !text ? 'empty' : null,\n    payload: {\n      source: 'email',\n      message: text,\n      name,\n      email,\n      subject: headers.subject || null,\n      external_id: msg.id,\n      thread_id: msg.threadId,\n      message_id_header: headers['message-id'] || null,\n    },\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "5f22115a-be27-591a-a97e-eeb251202a7a",
      "name": "Skip?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3300,
        300
