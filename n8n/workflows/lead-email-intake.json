      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $('Config').first().json.alerts_channel, text: ':warning: An email from ' + ($json.from || 'unknown sender') + ' could not be handed to the agent (status ' + $json.status + '). If it was labelled it keeps the label and will be retried.' }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
