# Copy this file to .env and fill in real values. Never commit .env.

# n8n (self-hosted, public HTTPS)
N8N_BASE_URL=https://your-n8n-domain.com
N8N_WEBHOOK_SECRET=a-long-random-string-shared-with-the-dashboard
# n8n API key (Settings > n8n API). Lets scripts create and update workflows.
N8N_API_KEY=

# AI. AI_PROVIDER picks which one is used: openai or anthropic.
AI_PROVIDER=openai

# OpenAI (current provider). Model is picked in phase 3 from the eval.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (optional, for comparing providers later)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Slack (its own app, separate from the invoice one)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL_ID=
SLACK_ALERTS_CHANNEL_ID=

# Gmail intake. The label must be one no existing filter would ever apply.
GMAIL_INTAKE_ADDRESS=
GMAIL_INTAKE_LABEL=lead-demo

# Outbound email only ever goes to these addresses (comma separated).
OUTBOUND_EMAIL_ALLOWLIST=

# Clock. demo = 1 day passes in DEMO_MINUTES_PER_DAY minutes. real = normal days.
CLOCK_MODE=demo
DEMO_MINUTES_PER_DAY=1

# Public demo limits
DEMO_LEADS_PER_IP_PER_DAY=3
DEMO_MESSAGES_PER_THREAD=10
DEMO_DAILY_AI_CALL_CAP=300
DEMO_LEAD_RETENTION_HOURS=24

# Dashboard: random salt for hashing visitor IPs (rate limiting)
IP_HASH_SALT=
